#!/bin/bash
# Diagnose and fix common Jellyfin issues.

echo ""
echo "  Jellyfin Troubleshooter"
echo "  ======================"
echo ""

ISSUES=0

# 1. Is Jellyfin running?
if pgrep -f "Jellyfin Server" > /dev/null 2>&1; then
    echo "  [OK] Jellyfin is running"
else
    echo "  [!!] Jellyfin is NOT running"
    echo "       Fix: opening Jellyfin now..."
    open -a Jellyfin
    sleep 5
    if pgrep -f "Jellyfin Server" > /dev/null 2>&1; then
        echo "       -> Started successfully"
    else
        echo "       -> Failed to start. Try: open -a Jellyfin"
        ISSUES=$((ISSUES + 1))
    fi
fi

# 2. Is the server responding?
if curl -s -o /dev/null --connect-timeout 3 http://localhost:8096/web/index.html 2>/dev/null; then
    echo "  [OK] Server responding on port 8096"
else
    echo "  [!!] Server NOT responding on port 8096"
    echo "       Fix: restarting Jellyfin..."
    pkill -f "Jellyfin Server" 2>/dev/null
    sleep 2
    open -a Jellyfin
    sleep 8
    if curl -s -o /dev/null --connect-timeout 3 http://localhost:8096/web/index.html 2>/dev/null; then
        echo "       -> Restarted successfully"
    else
        echo "       -> Still not responding. Check: lsof -i :8096"
        ISSUES=$((ISSUES + 1))
    fi
fi

# 3. Is the hard drive mounted?
if [ -d "/Volumes/Backup Plus/All Movies" ]; then
    MOVIE_COUNT=$(ls -d "/Volumes/Backup Plus/All Movies/"*/*/ 2>/dev/null | wc -l | tr -d ' ')
    echo "  [OK] Hard drive mounted — $MOVIE_COUNT movie folders found"
else
    echo "  [!!] Hard drive NOT mounted at /Volumes/Backup Plus/"
    if [ -d "/Volumes/Backup Plus 1/All Movies" ]; then
        echo "       Note: Found drive at '/Volumes/Backup Plus 1/' instead!"
        echo "       Fix: Eject both, unplug, replug the drive."
    else
        echo "       Fix: Plug in the Seagate Backup Plus drive."
    fi
    ISSUES=$((ISSUES + 1))
fi

# 4. Network — can the TV reach this?
IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)
if [ -n "$IP" ]; then
    echo "  [OK] WiFi connected — address: http://$IP:8096"
else
    echo "  [!!] Not connected to WiFi"
    echo "       Fix: Connect to a WiFi network."
    ISSUES=$((ISSUES + 1))
fi

# 5. Auto-discovery
if lsof -i :7359 -P -n 2>/dev/null | grep -q jellyfin; then
    echo "  [OK] Auto-discovery active (UDP 7359)"
else
    echo "  [!!] Auto-discovery NOT running"
    echo "       Fix: restart Jellyfin."
    ISSUES=$((ISSUES + 1))
fi

# 6. Check recent logs for errors
LOG="$HOME/.jellyfin-launcher.log"
if [ -f "$LOG" ]; then
    ERRORS=$(grep -c "ERROR" "$LOG" 2>/dev/null)
    if [ "$ERRORS" -gt 0 ]; then
        echo "  [!!] $ERRORS error(s) in launcher log"
        echo "       Last error:"
        grep "ERROR" "$LOG" | tail -1 | sed 's/^/       /'
    else
        echo "  [OK] No errors in launcher log"
    fi
fi

echo ""
if [ $ISSUES -eq 0 ]; then
    echo "  Everything looks good!"
else
    echo "  Found $ISSUES issue(s) above."
fi

# 7. Offer to scan
if [ $ISSUES -eq 0 ]; then
    echo ""
    read -n 1 -s -r -p "  Trigger a library scan? (y/n) " REPLY
    echo ""
    if [ "$REPLY" = "y" ]; then
        ~/jellyfin-scan
    fi
fi

echo ""
read -n 1 -s -r -p "  Press any key to close..."

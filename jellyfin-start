#!/bin/bash
# jellyfin-start — Login launcher (run by "Jellyfin Launcher.app"). Picks DRIVE or TRAVEL mode automatically,
# starts Jellyfin, scans for new films (incremental), syncs the film list, and keeps watching:
#   - drive unplugged while in drive mode  -> switches to travel mode and restarts Jellyfin
#   - drive plugged in while in travel mode -> switches to drive mode and restarts Jellyfin
# Prevents Mac sleep and disk sleep while Jellyfin is running.
#
# Usage: ~/jellyfin-start   (installed copy at ~/jellyfin-start; source of truth: ~/jellyfin-mac-setup/jellyfin-start)
# Requires: Jellyfin.app, ~/jellyfin-mac-setup/jellyfin-mode, sync-library.sh.
#
# Gotchas:
#   - Mode switching = jellyfin-mode (data + config + library list swapped together). Never add/remove libraries
#     to cope with a missing drive: that forced full re-imports of ~520 films (Oct 2026).
#   - A scan in drive mode is incremental (~50 s with nothing new); only new/changed films are processed.

DRIVE="/Volumes/Backup Plus"
REPO_DIR="$HOME/jellyfin-mac-setup"
MODE="$REPO_DIR/jellyfin-mode"
LOG="$HOME/.jellyfin-launcher.log"

log() { echo "$(date '+%H:%M:%S') $1" >> "$LOG"; }

# Keep only last 300 lines of log
tail -300 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null

log "=== Launcher started ==="
pkill -f "jellyfin-watchdog" 2>/dev/null

# 1. pick the mode (drive if plugged in, else travel), then start Jellyfin
bash "$MODE" auto >> "$LOG" 2>&1
if ! pgrep -f "Jellyfin Server" > /dev/null 2>&1; then
    open /Applications/Jellyfin.app
    log "Started Jellyfin ($(bash "$MODE" status | cut -d'|' -f1))"
else
    log "Jellyfin already running"
fi

# 2. keep the Mac (and drive) awake while Jellyfin runs
(
    sleep 10
    JF_PID=$(pgrep -f "Jellyfin Server" | head -1)
    if [ -n "$JF_PID" ]; then
        caffeinate -s -m -i -w "$JF_PID" &
        log "caffeinate started watching Jellyfin (PID $JF_PID)"
    fi
) &

scan_and_sync() {
    # wait for the server, scan (incremental), then sync the film list
    local tries=0 token
    until curl -s -o /dev/null http://localhost:8096/web/index.html 2>/dev/null; do
        tries=$((tries + 1)); [ $tries -ge 60 ] && { log "ERROR: Jellyfin not responding after 2 minutes"; return 1; }
        sleep 2
    done
    sleep 5
    token=$(curl -s -X POST http://localhost:8096/Users/AuthenticateByName -H "Content-Type: application/json" \
        -H 'X-Emby-Authorization: MediaBrowser Client="Launcher", Device="Mac", DeviceId="launcher", Version="1.0"' \
        -d '{"Username": "pjdruck", "Pw": "8544"}' 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['AccessToken'])" 2>/dev/null)
    [ -z "$token" ] && { log "ERROR: could not log in to Jellyfin"; return 1; }
    curl -s -X POST "http://localhost:8096/Library/Refresh" -H "X-Emby-Token: $token"
    log "Library scan triggered ($(bash "$MODE" status | cut -d'|' -f1))"
    sleep 90   # incremental scan of ~520 films takes ~50 s
    if [ -x "$REPO_DIR/sync-library.sh" ]; then
        "$REPO_DIR/sync-library.sh" --push >> "$LOG" 2>&1 && log "Film list synced" || log "WARNING: film list sync failed"
    fi
}
scan_and_sync &

# 3. watchdog: follow the drive. Unplugged in drive mode -> travel; plugged in during travel mode -> drive.
(
    exec -a "jellyfin-watchdog" bash -c '
    DRIVE="'"$DRIVE"'"; MODE="'"$MODE"'"; LOG="'"$LOG"'"; LAUNCHER="'"$0"'"
    log() { echo "$(date "+%H:%M:%S") [watchdog] $1" >> "$LOG"; }
    sleep 30
    while true; do
        sleep 60
        pgrep -f "Jellyfin Server" > /dev/null 2>&1 || { log "Jellyfin stopped — watchdog exiting"; break; }
        mode=$(bash "$MODE" status | sed -n "s/^mode: \([a-z]*\).*/\1/p")
        if [ "$mode" = drive ] && [ ! -d "$DRIVE/All Movies" ]; then
            log "Drive disconnected — switching to travel mode"
            osascript -e "display notification \"Drive unplugged — switched to travel mode (laptop films)\" with title \"Jellyfin\"" 2>/dev/null
            bash "$MODE" travel --start >> "$LOG" 2>&1; exec "$LAUNCHER"
        elif [ "$mode" = travel ] && [ -d "$DRIVE/All Movies" ]; then
            log "Drive connected — switching to drive mode"
            osascript -e "display notification \"Drive plugged in — switched to drive mode\" with title \"Jellyfin\"" 2>/dev/null
            bash "$MODE" drive --start >> "$LOG" 2>&1; exec "$LAUNCHER"
        fi
    done
    '
) &

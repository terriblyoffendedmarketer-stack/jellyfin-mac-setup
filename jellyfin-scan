#!/bin/bash
# Trigger Jellyfin to scan for new movies only (not a full rescan)
AUTH=$(curl -s -X POST http://localhost:8096/Users/AuthenticateByName \
  -H "Content-Type: application/json" \
  -H "X-Emby-Authorization: MediaBrowser Client=\"Setup\", Device=\"Mac\", DeviceId=\"setup1\", Version=\"1.0\"" \
  -d '{"Username": "pjdruck", "Pw": "8544"}')

TOKEN=$(echo "$AUTH" | python3 -c "import sys,json; print(json.load(sys.stdin)['AccessToken'])" 2>/dev/null)

if [ -z "$TOKEN" ]; then
    echo "Could not connect to Jellyfin. Is it running?"
    exit 1
fi

curl -s -X POST "http://localhost:8096/Library/Refresh" \
  -H "X-Emby-Token: $TOKEN"

echo "Scan triggered — Jellyfin will pick up new films shortly."
